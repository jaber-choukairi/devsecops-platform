{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Spring Boot Backend",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": [
                "spring-boot:run"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}